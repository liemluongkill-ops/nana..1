# Discord bot token from Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Optional allowlist. Leave blank while testing in one private server/channel.
# Optional guild/channel allowlists are supported by the runtime.
# Add their environment variables only in your local .env file.

# Users can call Nana with: !nana <message>
DISCORD_TRIGGER_PREFIX=!nana
DISCORD_AUTO_JOIN_USER_VOICE=1
DISCORD_MIRROR_TEXT_REPLY=1

# File queue contract with Nana core/chat branch. Repository-relative defaults
# are used automatically; uncomment only to override them.
# NANA_REQUEST_DIR=<repo>/nana/data/external_bridge/requests
# NANA_REPLY_DIR=<repo>/nana/data/external_bridge/replies
# NANA_DISCORD_ROUTES_PATH=<repo>/components/discord-bridge/routes.json
NANA_REPLY_TIMEOUT_SECONDS=120
NANA_REPLY_POLL_SECONDS=0.25
